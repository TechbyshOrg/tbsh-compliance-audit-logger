# Exclude Version Control files
.git
.github
.gitignore
.gitattributes
.distignore
.wordpress-org/

# Exclude Development metadata & configuration files
node_modules/
package.json
package-lock.json
webpack.config.js
composer.json
composer.lock
vendor/
scratch/
src/

# Exclude Documentation (retained under docs/ in repo but excluded from distribution build)
docs/

# Exclude exports directory
exports/

# Exclude release packages
*.zip
